# Configuración de la Base de Datos
DB_HOST=db  # Importante: el host es el nombre del servicio en docker-compose
DB_NAME=gastos
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=clavesegura
DB_ROOT_PASSWORD=otraclavesegura

# Configuración de Django
DJANGO_SECRET_KEY=
# En producción debe quedar en False (activa HTTPS, cookies seguras y logging).
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=web.settings

# Secreto compartido con n8n (workflow Gastos2). Se envía en el header
# X-API-Key al endpoint /accounts/api/verify-user/.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
N8N_API_SECRET=

# Opcional: IPs de proxies de confianza para leer X-Forwarded-For.
# Las IPs privadas de Docker ya se consideran de confianza por defecto.
TRUSTED_PROXY_IPS=

# Redis (default apunta al servicio docker "redis")
REDIS_URL=redis://redis:6379/1

# Email / recuperación de contraseña
# Por defecto usa consola (seguro si no hay SMTP). En producción:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@gastos.sverina.com.ar
# Token de reset válido por 1 hora
PASSWORD_RESET_TIMEOUT=3600

# Configuración del Bot
TELEGRAM_BOT_TOKEN='TELEGRAM_BOT_TOKEN' 
ADMIN_CHAT_ID='ChatId del administrador'
