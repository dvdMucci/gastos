<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Sistema de Gestión{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .filter-chip {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            margin: .15rem .25rem .15rem 0;
            padding: .35rem .65rem;
            border-radius: 999px;
            background: #e7f1ff;
            color: #0d47a1;
            text-decoration: none;
            font-size: .875rem;
        }
        .filter-chip:hover {
            background: #d0e4ff;
            color: #0a3d8f;
        }
        .filter-chip .chip-x {
            font-size: .75rem;
            opacity: .7;
        }
        @media (max-width: 767.98px) {
            .view-list-only-desktop { display: none !important; }
            .view-cards-mobile-default { display: block !important; }
        }
    </style>
    {% block extra_css %}{% endblock %}
</head>
<body>
    {% if user.is_authenticated %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{% url 'dashboard' %}">
                <i class="fas fa-cogs"></i> Sistema de Gestión
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{% url 'dashboard' %}">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{% url 'finances:expense_list' %}">
                            <i class="fas fa-receipt"></i> Finanzas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{% url 'income:income_list' %}">
                            <i class="fas fa-coins"></i> Ingresos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{% url 'subscriptions:subscription_list' %}">
                            <i class="fas fa-sync-alt"></i> Suscripciones
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{% url 'forecasts:forecast_dashboard' %}">
                            <i class="fas fa-chart-line"></i> Estimaciones
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{% url 'security:blocked_ips' %}">
                            <i class="fas fa-shield-alt"></i> Seguridad
                        </a>
                    </li>

                    {% if user.can_manage_users %}
                    <li class="nav-item">
                        <a class="nav-link" href="{% url 'user_list' %}">
                            <i class="fas fa-users"></i> Usuarios
                        </a>
                    </li>
                    {% endif %}


                </ul>
                
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-user"></i> {{ user.username }}
                            <span class="badge bg-primary ms-1">{{ user.get_user_type_display }}</span>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{% url 'profile' %}">
                                <i class="fas fa-user-edit"></i> Mi Perfil
                            </a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" action="{% url 'logout' %}" class="m-0">
                                    {% csrf_token %}
                                    <button type="submit" class="dropdown-item">
                                        <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    {% endif %}

    <div class="container mt-4">
        {% if messages %}
            {% for message in messages %}
                <div class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endif %}

        {% block content %}{% endblock %}
    </div>

    <!-- Toast container -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
        <div id="app-toast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="app-toast-body"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    function showToast(message, type) {
        const toastEl = document.getElementById('app-toast');
        const bodyEl = document.getElementById('app-toast-body');
        if (!toastEl || !bodyEl) return;
        bodyEl.textContent = message;
        toastEl.classList.remove('bg-success', 'bg-danger', 'bg-primary', 'bg-secondary');
        toastEl.classList.add(type === 'error' ? 'bg-danger' : 'bg-success');
        bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 2500 }).show();
    }

    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(() => {
            showToast('Descripción copiada al portapapeles', 'success');
        }).catch(() => {
            showToast('No se pudo copiar al portapapeles', 'error');
        });
    }

    function bindSubmitSpinner(form, loadingText) {
        if (!form || form.dataset.spinnerBound === '1') return;
        form.dataset.spinnerBound = '1';
        form.addEventListener('submit', function() {
            const btn = form.querySelector('[type="submit"]');
            if (!btn || btn.disabled) return;
            btn.disabled = true;
            const original = btn.innerHTML;
            btn.dataset.originalHtml = original;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>' +
                (loadingText || 'Cargando...');
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('form[data-loading]').forEach(function(form) {
            bindSubmitSpinner(form, form.dataset.loading || 'Cargando...');
        });
        // Auto-submit selects (month selector) show a light loading state
        document.querySelectorAll('select[onchange*="submit"]').forEach(function(sel) {
            sel.addEventListener('change', function() {
                const form = sel.form;
                if (!form) return;
                const overlay = document.getElementById('form-loading-overlay');
                if (overlay) overlay.classList.remove('d-none');
                sel.disabled = true;
                Array.from(form.querySelectorAll('select, button, input')).forEach(function(el) {
                    if (el !== sel) el.disabled = true;
                });
            });
        });
    });
    </script>
    {% block extra_js %}{% endblock %}
</body>
</html>
